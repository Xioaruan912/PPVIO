# PPVIO compose input. Copy to /root/ppvio/ppvio.env with mode 0600 (never commit it).
PPVIO_IMAGE=ppvio:replace-before-deploy
PPVIO_ENABLED=false
PPVIO_HOST=0.0.0.0
PPVIO_PORT=8790
PPVIO_HOST_DATA_DIR=/root/ppvio/data

# Generate a 32+ character secret for PPVIO. A single-owner
# deployment may instead use an exact 9-digit numeric PIN. Do not reuse
# BOT_TOKEN, API_HASH, a Telegram session, or the Bot Archive write credential.
PPVIO_ACCESS_SECRET=
# Generate on the VPS with 32 random bytes, URL-safe base64 without padding.
# Keep this key stable across redeployments; a new VPS must use the same key.
PPVIO_RECOVERY_KEY=
# 网盘（WebDAV）地址、账号、密码和归档目录不在这里配置：
# 部署后登录播放器，在 设置 → 存储 页面填写。
PPVIO_DELETE_ENABLED=false

PPVIO_CATALOG_POLL_SECONDS=60
PPVIO_MAX_STREAMS=8
PPVIO_MAX_STREAMS_PER_CLIENT=4
# Clips longer than this many seconds are treated as large videos.
PPVIO_LARGE_VIDEO_SECONDS=300
# Build virtual faststart overlays for existing clips in the background.
PPVIO_FASTSTART_BACKFILL=true
# 磁盘缓存总预算（字节），固定上限，不随片库增长。默认 4 GiB：
# 一半给各视频开头（秒开），一半给正在看的内容。
PPVIO_CACHE_BYTES=4294967296
PPVIO_CACHE_CHUNK_MB=1
# Upstream read window and concurrent window fetches (115/OpenList throttles >4).
PPVIO_CACHE_WINDOW_MB=32
PPVIO_CACHE_CONCURRENCY=4
# 预热视频开头，最新入库的优先；开头区占满一半预算即停止，不会互相挤占。
PPVIO_WARM_ALL=true
PPVIO_WARM_HEAD_MB=4

# 可选：115 直连读取。填宿主机上 OpenList 的 API 地址（经 Docker 网关），
# 留空则只用网盘（WebDAV）。开启后在播放器设置里选择“读取方式”。
PPVIO_OPENLIST_API_URL=
# 直链与取链时的 User-Agent 绑定；一般无需修改。
PPVIO_DIRECT_USER_AGENT=
# 可选：Player 与 OpenList 在同一台 VPS/内网时，网盘（WebDAV）改走内网，
# 例如 http://host.docker.internal:5244/dav；留空则走存储设置页面里的公网 HTTPS 地址。
PPVIO_WEBDAV_INTERNAL_URL=
